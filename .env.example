# Copie para .env (o bun carrega sozinho). Valores abaixo = docker-compose.yml de desenvolvimento.
# Em produção: sslmode=require e senhas fortes.

# Aplicação (oc_app, sujeita a RLS)
DATABASE_URL=postgres://oc_app:oc_app_dev@localhost:5442/concierge
# Portal /admin e worker (oc_admin, vê todos os clientes)
DATABASE_URL_ADMIN=postgres://oc_admin:oc_admin_dev@localhost:5442/concierge
# Migrations (oc_owner, dono das tabelas). Nunca usar na aplicação.
DATABASE_URL_MIGRATIONS=postgres://oc_owner:oc_owner_dev@localhost:5442/concierge

# Better Auth (gere com: openssl rand -base64 32)
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-caracteres
BETTER_AUTH_URL=http://localhost:8080

# Arquivos (API S3; em dev, SeaweedFS do docker-compose)
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=concierge
# Em dev o SeaweedFS aceita qualquer chave.
S3_ACCESS_KEY=dev
S3_SECRET_KEY=dev

# Senha dos usuários criados pelo seed (só desenvolvimento)
SEED_SENHA=operacondo123

# Segredo do hash do CPF (LGPD: CPF nunca em texto). Não trocar depois de ter dados.
CPF_PEPPER=troque-por-outro-segredo
